# Copy this file to .env and fill in your local PostgreSQL credentials.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mplads_ai

# JWT authentication settings.
# JWT_SECRET_KEY: required, no default. Generate a strong random value,
# e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
# Never commit your actual secret -- this file only documents the
# variable names.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60