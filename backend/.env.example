# Copy this file to .env (already gitignored) and fill in real values.
# Never commit .env, and never put real secrets in this file --
# everything below is a placeholder.

# --- Database (required, no default -- see app/database.py) -------------
DATABASE_URL=postgresql://username:password@localhost:5432/mplads_ai_shield

# --- JWT (required, no default -- see app/auth.py) -----------------------
# Generate a strong random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS (see app/main.py's _resolve_cors_origins()) ---------------------
# Comma-separated list of allowed frontend origins.
# Optional in development (defaults to the local Vite dev server origins
# if unset). REQUIRED when ENVIRONMENT=production -- the app will refuse
# to start without it.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Environment (see app/main.py) ----------------------------------------
# "development" (default) keeps interactive docs (/docs, /redoc,
# /openapi.json) enabled and defaults CORS_ORIGINS to local dev origins.
# "production" disables interactive docs and requires CORS_ORIGINS to be
# set explicitly.
ENVIRONMENT=development